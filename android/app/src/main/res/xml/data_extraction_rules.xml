<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup / device-to-device transfer. Same set as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <!-- Holds the signed-in account and the install_id: never restored onto another device. -->
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
        <include domain="root" path="app_flutter/granth/catalog.json" />
        <include domain="root" path="app_flutter/granth/folders.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <!-- Holds the signed-in account and the install_id: never restored onto another device. -->
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
        <include domain="root" path="app_flutter/granth/catalog.json" />
        <include domain="root" path="app_flutter/granth/folders.json" />
    </device-transfer>
</data-extraction-rules>
